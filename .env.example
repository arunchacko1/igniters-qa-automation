# Copy this file to .env and adjust values for your machine.
# docker-compose and the test suites read these at runtime.

# --- Database ---
POSTGRES_DB=igniters_qa
POSTGRES_USER=igniters
POSTGRES_PASSWORD=change-me-locally
DB_HOST=localhost
DB_PORT=5432

# --- SUT application ---
# Toggles the 5 deliberately seeded defects used to prove the test suites
# can actually catch bugs. Must be "false" for the suites to pass cleanly.
QA_DEFECTS_ENABLED=false
SUT_PORT=8080
# Signing key for API bearer tokens. Any long random string works locally.
AUTH_TOKEN_SECRET=local-dev-secret-change-me

# --- Test suites (base URL is configurable so tests can target any environment) ---
BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080/api
SELENIUM_HEADLESS=true
